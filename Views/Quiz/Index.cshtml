@model List<EcoKids.Models.Question>

    <style>
        /* Style spécial enfants */
        .quiz-container {
            font-family: 'Comic Sans MS', 'Chalkboard SE', 'Comic Neue', sans-serif;
            max-width: 800px;
            margin: 0 auto;
        }

        .question-card {
            border: none;
            border-radius: 25px;
            box-shadow: 0 8px 20px rgba(0, 100, 0, 0.15);
            background: #ffffff;
            transition: transform 0.2s;
        }

            .question-card:hover {
                transform: translateY(-3px);
            }

        .question-title {
            color: #2e7d32;
            font-weight: bold;
            font-size: 1.5rem;
        }
        /* Cacher les vrais boutons radio */
        .custom-radio-input {
            display: none;
        }
        /* Créer de gros boutons pour les réponses */
        .custom-radio-label {
            display: block;
            padding: 15px 20px;
            margin-bottom: 10px;
            background-color: #f1f8e9;
            border: 2px solid #c8e6c9;
            border-radius: 15px;
            font-size: 1.2rem;
            color: #333;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .custom-radio-label:hover {
                background-color: #dcedc8;
                border-color: #8bc34a;
            }
        /* Quand le bouton est sélectionné */
        .custom-radio-input:checked + .custom-radio-label {
            background-color: #4caf50;
            border-color: #2e7d32;
            color: white;
            font-weight: bold;
            box-shadow: 0 4px 10px rgba(76, 175, 80, 0.4);
        }
        /* Le gros bouton valider */
        .btn-valider {
            background-color: #ff9800;
            border: none;
            border-radius: 50px;
            padding: 15px 40px;
            font-size: 1.5rem;
            font-weight: bold;
            color: white;
            box-shadow: 0 6px 0 #e65100;
            transition: all 0.1s;
        }

            .btn-valider:active {
                transform: translateY(6px);
                box-shadow: 0 0 0 #e65100;
            }
    </style>

    <div class="quiz-container py-4">
        <h1 class="text-center mb-5" style="color: #2e7d32; font-weight: bold; text-shadow: 2px 2px 4px rgba(0,0,0,0.1);">
            🌿 Quiz de l'écologiste 🌿
        </h1>

        <form asp-action="Corriger" method="post">
            @foreach (var q in Model)
        {
            <input type="hidden" name="questionIds" value="@q.Id" />

            <div class="card question-card mb-4">
                <div class="card-body p-4">
                    <h4 class="question-title mb-4">@q.Enonce</h4>

                    @for (int i = 0; i < q.Choix.Count; i++)
                    {
                        var idUnique = $"q{q.Id}_{i}";
                    <div class="mb-2">
                        <input class="custom-radio-input" type="radio"
                               name="reponses[@(q.Id)]" id="@idUnique" value="@i" required />
                        <label class="custom-radio-label" for="@idUnique">
                            @if(i == 0) { <span>🅰️</span> }
                                else if(i == 1) { <span>🅱️</span> }
                                else { <span>🇨</span> }
                            @q.Choix[i]
                        </label>
                    </div>
                    }
                </div>
            </div>
        }

            <div class="text-center mt-5 mb-5">
                <button type="submit" class="btn btn-valider">
                    🚀 Valider mes réponses !
                </button>
            </div>
        </form>
    </div>
