@model EcoKids.Models.ResultatQuiz

<style>
    .result-container {
        font-family: 'Comic Sans MS', 'Chalkboard SE', 'Comic Neue', sans-serif;
        max-width: 800px;
        margin: 0 auto;
    }

    .score-circle {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        background: linear-gradient(135deg, #4caf50, #8bc34a);
        color: white;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        margin: 0 auto 20px auto;
        box-shadow: 0 10px 20px rgba(76, 175, 80, 0.4);
        border: 5px solid #fff;
    }

    .score-number {
        font-size: 3.5rem;
        font-weight: bold;
        line-height: 1;
    }

    .result-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .correct-card {
        border-left: 10px solid #4caf50;
        background-color: #f1f8e9;
    }

    .wrong-card {
        border-left: 10px solid #f44336;
        background-color: #ffebee;
    }

    .btn-rejouer {
        background-color: #2196f3;
        border-radius: 50px;
        padding: 10px 30px;
        font-size: 1.3rem;
        font-weight: bold;
        color: white;
        box-shadow: 0 4px 0 #1565c0;
        text-decoration: none;
    }

        .btn-rejouer:active {
            transform: translateY(4px);
            box-shadow: none;
        }
</style>

<div class="result-container py-4">

    <div class="text-center mb-5">
        <div class="score-circle">
            <span class="score-number">@Model.Score/@Model.Total</span>
            <span style="font-size: 1.2rem;">Points</span>
        </div>
        <h2 style="color: #2e7d32; font-weight: bold;">@Model.Message</h2>
        <p class="fs-4 text-muted">Tu as gagné <strong>@Model.PointsGagnes étoiles</strong> 🌟</p>
    </div>

    <h4 class="mb-4" style="color: #555;">Les corrections :</h4>

    @foreach (var c in Model.Corrections)
    {
        var cardClass = c.EstCorrecte ? "correct-card" : "wrong-card";
        var icon = c.EstCorrecte ? "✅" : "❌";

    <div class="card result-card @cardClass mb-3">
        <div class="card-body p-4">
            <h5 class="mb-3">@icon @c.Question.Enonce</h5>

            <p class="mb-2 fs-5">
                Ta réponse :
                <strong>@(c.IndexChoisi >= 0 ? c.Question.Choix[c.IndexChoisi] : "Aucune réponse")</strong>
            </p>

            @if (!c.EstCorrecte)
                {
            <p class="mb-2 fs-5 text-success">
                La bonne réponse était : <strong>@c.Question.Choix[c.Question.IndexBonneReponse]</strong>
            </p>
                }
            <div class="mt-3 p-3 bg-white rounded-3 border">
                💡 <em>Le savais-tu ? @c.Question.Explication</em>
            </div>
        </div>
    </div>
    }

    <div class="text-center mt-5 mb-5">
        <a asp-action="Index" class="btn-rejouer">🔄 Rejouer au quiz</a>
    </div>
</div>